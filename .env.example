# Camera origins only, including http:// or https:// and an optional port.
IPRO_FOOD_NAME=
IPRO_FOOD_BASE_URL=
IPRO_FOOD_USER=
IPRO_FOOD_PASSWORD=

IPRO_ISLAND_NAME=
IPRO_ISLAND_BASE_URL=
IPRO_ISLAND_USER=
IPRO_ISLAND_PASSWORD=

IPRO_TIMEOUT_MS=10000

# Comma-separated history kinds. An empty value disables collection for the camera.
IPRO_FOOD_HISTORY_KINDS=linecross
IPRO_ISLAND_HISTORY_KINDS=linecross,heatmap_mov,heatmap_loi

CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_D1_DATABASE_ID=your-database-id
CLOUDFLARE_API_TOKEN=your-d1-token

# Explicit thumbnail acquisition. Alternatives: heatmap_mov or heatmap_loi.
IPRO_FOOD_THUMBNAIL_KIND=movcnt
IPRO_ISLAND_THUMBNAIL_KIND=movcnt

# R2 S3 credentials scoped to the private thumbnail bucket.
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_ENDPOINT=https://your-account-id.eu.r2.cloudflarestorage.com

# For a private HTTPS port forward that preserves Host, set its exact origin.
# IPRO_ADMIN_ALLOWED_ORIGIN=https://your-private-forward.example
